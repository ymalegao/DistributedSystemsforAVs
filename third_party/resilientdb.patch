+              << " omnet_self="
+              << OmnetForcedView::ResdbSenderToOmnet(config_.GetSelfInfo().id())
+              << " seq=" << request.seq()
+              << " type=" << RequestTypeName(request.type())
+              << " sender=" << request.sender_id()
+              << " hash=" << request.hash()
+              << " result=" << (view ? "hit" : "miss");
+    if (view) {
+      std::cout << " view_epoch=" << view->epoch
+                << " view_seq=" << view->seq
+                << " N=" << view->active_omnet_ids.size()
+                << " quorum=" << view->quorum
