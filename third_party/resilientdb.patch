+  struct ViewKey {
+    uint32_t epoch = 0;
+    uint64_t seq = 0;
+    std::string hash;
+
+    bool operator<(const ViewKey& other) const {
+      if (epoch != other.epoch) return epoch < other.epoch;
+      if (seq != other.seq) return seq < other.seq;
+      return hash < other.hash;
+    }
+  };
