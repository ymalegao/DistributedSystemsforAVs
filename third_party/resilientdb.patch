 }
 
+void SleepForUs(uint64_t delta_us) {
+  // If sim-time is active, block on the sim-time condition variable instead
+  // of wall-clock sleep.
+  if (SimTimeProvider::NowUs() != 0) {
+    SimTimeProvider::SleepForUs(delta_us);
+    return;
+  }
+  usleep(delta_us);
+}
