+        if (laneId.empty() || laneId.front() == ':') return -1.0;
+        const double laneLength =
+            mobility->getCommandInterface()->lane(laneId).getLength();
+        return std::max(0.0, laneLength - vehicle.getLanePosition());
+    } catch (...) {
+        return -1.0;
+    }
