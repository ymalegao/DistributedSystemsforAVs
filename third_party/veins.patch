+void ResDBIntersectionApp::addLocalSelfAttestation(const ArrivalAnnouncement& ann)
+{
+    if (!ec_private_key_ || ann.carId != "veh" + std::to_string(replicaId_) ||
+            discovery_.state != DiscoveryState::COLLECTING || propose_submitted_ ||
