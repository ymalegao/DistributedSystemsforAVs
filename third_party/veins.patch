+                  << " egress=" << (phase2_trace_egress_edge_.empty() ? "-" : phase2_trace_egress_edge_)
+                  << " declaredLane=" << (intended_lane_.empty() ? "-" : intended_lane_)
+                  << " declaredDirection=" << (intended_direction_.empty() ? "-" : intended_direction_)
