+double ResDBIntersectionApp::vehicleDistanceToStopTraCI(
+    const std::string& carId) const
+{
+    if (!mobility || !mobility->getCommandInterface()) return -1.0;
+    try {
+        auto vehicle = mobility->getCommandInterface()->vehicle(carId);
