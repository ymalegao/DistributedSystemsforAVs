"""
Creates Makefile(s) for building this project.
"""

import os
import sys
import subprocess
import logging
from logging import info, warning, error
from optparse import OptionParser

# check python version
if sys.version_info[0] < 3:
    warning("Warning: running configure with Python 2 might result in subtle errors.")

# Option handling
parser = OptionParser()
parser.add_option("-v", "--verbose", dest="count_verbose", default=0, action="count", help="increase verbosity [default: don't log infos, debug]")
parser.add_option("-q", "--quiet", dest="count_quiet", default=0, action="count", help="decrease verbosity [default: log warnings, errors]")
parser.add_option("--with-inet", dest="inet", help='Option discontinued in favor of a subproject in subprojects/veins_inet/')
(options, args) = parser.parse_args()

_LOGLEVELS = (logging.ERROR, logging.WARN, logging.INFO, logging.DEBUG)
loglevel = _LOGLEVELS[max(0, min(1 + options.count_verbose - options.count_quiet, len(_LOGLEVELS)-1))]
logging.basicConfig(level=loglevel)

if args:
    warning("Superfluous command line arguments: \"%s\"" % " ".join(args))


# Start with default flags (--deep compiles all of src/; exclude legacy Java BFTSmart JNI).
makemake_flags = [
    '-f', '--deep', '--make-so', '-I', '.', '-o', 'veins', '-O', 'out', '-p', 'VEINS',
    '-X', 'veins/modules/bftsmart',
]

# ResilientDB bridge defaults for OMNeT++ integration.
# ResDBIntersectionApp.h includes "integration/omnet/resdb_omnet_bridge.h", so only
# -I<resdb_root> is required (not -I<resdb_root>/integration/omnet).
_default_resdb_root = os.path.abspath(
    os.path.join(os.path.dirname(__file__), '..', 'incubator-resilientdb'),
)
resdb_root = os.environ.get('RESDB_ROOT', _default_resdb_root)
resdb_bazel_bin = os.environ.get(
    'RESDB_BAZEL_BIN',
    os.path.join(resdb_root, 'bazel-bin'),
)
resdb_bridge_dir = os.environ.get(
    'RESDB_BRIDGE_DIR',
    os.path.join(resdb_bazel_bin, 'integration', 'omnet'),
)
resdb_bridge_lib = os.environ.get('RESDB_BRIDGE_LIB', 'resdb_omnet_bridge')

makemake_flags.extend([
    '-I' + resdb_root,
    '-L' + resdb_bridge_dir,
    '-l' + resdb_bridge_lib,
])



run_libs = [os.path.join('src', 'veins')]
run_neds = [os.path.join('src', 'veins')]
run_imgs = [os.path.join('images')]


# --with-inet has been discontinued
if options.inet:
        error('--with-inet has been discontinued in favor of a subproject in subprojects/veins_inet/')
        sys.exit(1)


# Start creating files
if not os.path.isdir('out'):
    os.mkdir('out')

f = open(os.path.join('out', 'config.py'), 'w')
f.write('run_libs = %s\n' % repr(run_libs))
f.write('run_neds = %s\n' % repr(run_neds))
f.write('run_imgs = %s\n' % repr(run_imgs))
f.close()

subprocess.check_call(['env', 'opp_makemake'] + makemake_flags, cwd='src')

info('Configure done. You can now run "make".')
