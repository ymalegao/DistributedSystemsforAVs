<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <!-- basic passenger car -->
  
    <vType id="vehS" accel="2.6" decel="4.5" sigma="0.5" length="2.5" minGap="2.5" maxSpeed="14" color="1,1,0"/>
    <vType id="vehN" accel="2.6" decel="4.5" sigma="0.5" length="2.5" minGap="2.5" maxSpeed="14" color="0,1,1"/>
    <vType id="vehE" accel="2.6" decel="4.5" sigma="0.5" length="2.5" minGap="2.5" maxSpeed="14" color="1,0,1"/>
    <vType id="vehW" accel="2.6" decel="4.5" sigma="0.5" length="2.5" minGap="2.5" maxSpeed="14" color="0.5,0.5,0.5"/>


    <!-- 4 routes: each starts on one arm and goes straight across -->
    <!-- you may need to add a second edge after each one if the network requires it,
         but this is the simplest starting point -->
    <route id="south_to_north" edges="10553209#0 34813111#1"/>
    <route id="north_to_south" edges="-34813111#1 -10553209#0"/>
    <route id="east_to_west"  edges="10555868#0 34813110#1"/>
    <route id="west_to_east"  edges="-34813110#1 -10555868#0"/>

    <!-- 4 vehicles, all depart at t=10 so they meet in the middle -->
    <vehicle id="vehS" type="vehS" route="south_to_north" depart="10.00"/>
    <vehicle id="vehN" type="vehN" route="north_to_south" depart="10.00"/>
    <vehicle id="vehE" type="vehE" route="east_to_west"  depart="10.00"/>
    <vehicle id="vehW" type="vehW" route="west_to_east"  depart="10.00"/>


</routes>
