# ── Vendored dependencies ─────────────────────────────────────────────────────
# Materialised by ./setup.sh from third_party/versions.lock. Never committed:
# the repo carries the pinned upstream refs plus our patches instead.
/.external/

# ── Build output ──────────────────────────────────────────────────────────────
out/
*.o
*.so
*.dylib
# The simulation binaries must be rebuilt locally — a committed one carries an
# rpath to whichever machine built it.
/scenarios/fourway/fourway
/scenarios/fourway/fourway_dbg
# Generated from .msg by opp_msgc.
*_m.cc
*_m.h

# ── Generated at setup/run time ───────────────────────────────────────────────
# Replica keys + certs. Regenerate with: tools/gen_crypto_dir.sh <N> <dir>
# (setup.sh does this for every scenario). Private keys are never committed.
/scenarios/fourway/resdb_crypto*/
# Per-run overrides written by tools/run-resdb-simulation.sh.
/scenarios/fourway/random_scenario.ini
/scenarios/fourway/leader_override.ini
/scenarios/fourway/channel_metrics_override.ini
# Generated by run_ablations.sh's ablation5.
/benchmarks/ablations/ab5_off.ini

# ── Experiment output ─────────────────────────────────────────────────────────
# Anchored per-directory rather than ignoring benchmarks/ wholesale: an
# unanchored "benchmarks/" also swallowed the ablation runner itself, which then
# had to be force-added. Same class of bug as the old unanchored "figures/".
/benchmarks/ablations/results/
/benchmarks/*.gif
/benchmarks/*.png
# Pre-plotter experiment output, kept on disk but never committed.
/benchmarks/Priority*cars/
/benchmarks/leaderrandom/
/scenarios/fourway/results/
partner_results/

# Golden-harness run logs (regenerable).
/tests/golden/logs/

# Stale vendored protoc from the retired BFTSmart/JNI path. Nothing in the
# build references it; the bridge uses Bazel's own protoc.
/bin/

# ── Editor / OS / language caches ─────────────────────────────────────────────
__pycache__/
*.pyc
.DS_Store
.metadata/
.settings/
.csettings/
.qtenvrc
