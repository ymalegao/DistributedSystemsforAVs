<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="14" color="1,1,0"/>
        <!-- Concrete straight routes retained for TraCI-injected vehicles: the
         rollback scenario's supervisor spawns veh16/veh17 naming "rN"/"rE" via
         the r0Late*Route parameters, which cannot reference a distribution. -->
    <route id="rN" edges="N2C C2S"/>
    <route id="rS" edges="S2C C2N"/>
    <route id="rE" edges="E2C C2W"/>
    <route id="rW" edges="W2C C2E"/>

    <routeDistribution id="dN">
        <route edges="N2C C2S"/>
        <route edges="N2C C2E"/>
        <route edges="N2C C2W"/>
    </routeDistribution>
    <routeDistribution id="dS">
        <route edges="S2C C2N"/>
        <route edges="S2C C2W"/>
        <route edges="S2C C2E"/>
    </routeDistribution>
    <routeDistribution id="dE">
        <route edges="E2C C2W"/>
        <route edges="E2C C2S"/>
        <route edges="E2C C2N"/>
    </routeDistribution>
    <routeDistribution id="dW">
        <route edges="W2C C2E"/>
        <route edges="W2C C2N"/>
        <route edges="W2C C2S"/>
    </routeDistribution>

    <vType id="ambulance" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="14" color="1,0,0"/>

    <!-- Routes from each direction -->

    <!-- 4 vehicles total -->
    <vehicle id="veh0" type="car" route="dN" depart="0" departSpeed="max" departPos="0"/>
    <vehicle id="veh1" type="car" route="dS" depart="0" departSpeed="max" departPos="0"/>
    <vehicle id="veh2" type="car" route="dE" depart="0" departSpeed="max" departPos="0"/>
        <!-- veh3 is the ambulance (ablation 4 pins priority to veh n-1).
         It takes its approach's concrete straight route, not the
         distribution: the measured vehicle must not have a random
         turn, or its own draw dominates the metric. -->
    <vehicle id="veh3" type="car" route="rW" depart="0" departSpeed="max" departPos="0"/>
</routes>