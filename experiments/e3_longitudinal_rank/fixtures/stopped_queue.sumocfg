<?xml version="1.0" encoding="UTF-8"?>
<configuration xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://sumo.dlr.de/xsd/sumoConfiguration.xsd">
    <input>
        <net-file value="stopped_queue.net.xml"/>
        <route-files value="stopped_queue.rou.xml"/>
    </input>
    <time><begin value="0"/><end value="5"/><step-length value="0.1"/></time>
    <processing><time-to-teleport value="-1"/></processing>
    <report><xml-validation value="never"/><xml-validation.net value="never"/><no-step-log value="true"/></report>
</configuration>
