<?xml version="1.0" encoding="UTF-8"?>
<routes>
    <vType id="car" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="22.92" color="1,1,0"/>
    <vType id="ambulance" accel="2.6" decel="4.5" sigma="0.5" length="4.5" minGap="2.5" maxSpeed="14" color="1,0,0"/>

    <route id="rN" edges="N2C C2S"/>
    <route id="rS" edges="S2C C2N"/>
    <route id="rE" edges="E2C C2W"/>
    <route id="rW" edges="W2C C2E"/>

    <!-- Initial wave: sixteen vehicles (veh0..veh15) arrive together for epoch 0.
         Lane assignment matches the SixteenVehiclesResDB node->veh->lane mapping so
         node[0..15].intendedLane is unchanged; only node[16]/node[17] are added. -->
    <vehicle id="veh0"  type="car" route="rN" depart="0" departSpeed="max" departPos="60"/>
    <vehicle id="veh9"  type="car" route="rN" depart="0" departSpeed="max" departPos="40"/>
    <vehicle id="veh11" type="car" route="rN" depart="0" departSpeed="max" departPos="20"/>
    <vehicle id="veh15" type="car" route="rN" depart="0" departSpeed="max" departPos="0"/>

    <vehicle id="veh1"  type="car" route="rS" depart="0" departSpeed="max" departPos="60"/>
    <vehicle id="veh6"  type="car" route="rS" depart="0" departSpeed="max" departPos="40"/>
    <vehicle id="veh8"  type="car" route="rS" depart="0" departSpeed="max" departPos="20"/>
    <vehicle id="veh13" type="car" route="rS" depart="0" departSpeed="max" departPos="0"/>

    <vehicle id="veh2"  type="car" route="rW" depart="0" departSpeed="max" departPos="60"/>
    <vehicle id="veh7"  type="car" route="rW" depart="0" departSpeed="max" departPos="40"/>
    <vehicle id="veh3"  type="car" route="rW" depart="0" departSpeed="max" departPos="20"/>
    <vehicle id="veh12" type="car" route="rW" depart="0" departSpeed="max" departPos="0"/>

    <vehicle id="veh4"  type="car" route="rE" depart="0" departSpeed="max" departPos="60"/>
    <vehicle id="veh5"  type="car" route="rE" depart="0" departSpeed="max" departPos="40"/>
    <vehicle id="veh10" type="car" route="rE" depart="0" departSpeed="max" departPos="20"/>
    <vehicle id="veh14" type="car" route="rE" depart="0" departSpeed="max" departPos="0"/>

    <!-- Late arrivals: pre-keyed replicas 16 (emergency) and 17 (normal) that were
         physically absent during epoch 0 and force an emergency rollback to M=16.
         depart=40 is tuned so they arrive AFTER epoch 0 commits (~t=18–23s with
         16 cars) and before the batch fully clears. Retune if timing shifts. -->
    <vehicle id="veh16" type="ambulance" route="rE" depart="4" departSpeed="max" departPos="0"/>
    <vehicle id="veh17" type="car"       route="rN" depart="4" departSpeed="max" departPos="0"/>
</routes>
