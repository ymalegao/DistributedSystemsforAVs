config extends FourVehiclesBFTOverV2V
config description "4 vehicles; veh3 auto-issues Emergency_CA cert (ambulanceReplicaId matches SUMO veh id, not node index)"
config *.node[*].appl.ambulanceReplicaId 3
config *.node[2].appl.isByzantine true
config *.node[2].appl.byzantineType 3
config extends BFTOverV2V
config description "BFT test on benchmarking 4-vehicle routes"
config *.manager.launchConfig "xmldoc(\"bft_4veh.launchd.xml\")"
config *.node[*].appl.intersectionX 300m
config *.node[*].appl.intersectionY 300m
config *.node[*].appl.stopDistance 50m
config extends WithChannelSwitching
config *.node[*].applType "\"org.car2x.veins.modules.bftsmart.V2VProxyModule\""
